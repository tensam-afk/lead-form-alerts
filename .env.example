BUSINESS_NAME=Acme Interiors

# Optional: require ?key=... (or an X-Webhook-Key header) on /webhook
WEBHOOK_SECRET=

# Storage: leave GOOGLE_SHEET_ID empty to save to data/leads.csv instead
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json

# Email alerts (for Gmail, use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp alerts via Twilio (numbers in +countrycode format)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_TO=
